# vim: set filetype=cmake
# vim: set syntax=cmake

# For Debuging the Makefile
set( CMAKE_VERBOSE_MAKEFILE ON )

# output compiler flags
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_C_STANDARD 99)
set(CMAKE_C_STANDARD_REQUIRED OFF)


set(APP_C_FLAGS "-Wall -Wextra" )

set(CMAKE_DEBUG_POSTFIX d)
set(APP_NAME "jsoncpp")
set(APP_EMAIL "https://github.com/open-source-parsers/jsoncpp")
set(APP_VENDOR "https://github.com/open-source-parsers/jsoncpp")
set(APP_DESCRIPTION "Bibliothek zum lesen und schreiben von Json Files")



set(APP_VERSION_MAJOR 1) # will be increased on incompatible changes
set(APP_VERSION_MINOR 9) # will be increased on new features in backwards compatible manner
set(APP_VERSION_PATCH 4) # will be increased on bugfixes



